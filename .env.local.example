# Modelo de variáveis de ambiente. Copie pra .env.local e preencha.
# .env.local NUNCA é commitado (está no .gitignore).

# ── Modo "em breve" (pré-lançamento) ──────────────────────────────────────────
# "on" liga a tela /em-breve pro público (home, cardápio, carrinho, presentear
# redirecionam pra lá). Gestão, login, API e conta seguem livres pra equipe.
# Qualquer outro valor (ou ausência) = site normal.
# No lançamento: trocar pra "off" no Vercel (Settings → Environment Variables) —
# não precisa deploy de código, só redeploy/restart.
NEXT_PUBLIC_COMING_SOON=off

# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # só server — nunca expor no client

# ── AbacatePay (pagamento) ────────────────────────────────────────────────────
ABACATEPAY_API_KEY=
ABACATEPAY_WEBHOOK_SECRET=
ABACATEPAY_ENV=dev

# ── WhatsApp Cloud API ────────────────────────────────────────────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ── PostHog (analytics) ───────────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
